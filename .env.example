# Secrets for Argus. Copy to .env (never commit .env).
ARGUS_ADMIN_PASSWORD=change-me
# Workers and apps send this as "Authorization: Bearer <token>". Leave empty to disable (local dev only).
ARGUS_WORKER_TOKEN=
# ntfy topic for phone notifications: pick something long and random, e.g. argus-7f3k2q9x. Empty = off.
NTFY_TOPIC=
# Only for your own ntfy server with access control:
NTFY_TOKEN=
