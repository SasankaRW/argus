# Secrets for Argus. Copy to .env (never commit .env).
ARGUS_ADMIN_PASSWORD=change-me
# Workers and apps send this as "Authorization: Bearer <token>". Leave empty to disable (local dev only).
ARGUS_WORKER_TOKEN=
# Tracker and Life Hub (plugins tracker, lifehub): the API_KEY from each app's own .env
TRACKER_API_KEY=
LIFEHUB_API_KEY=
# Gmail (plugin gmail): a Google Cloud OAuth client of type Desktop app (docs/setup.md, Gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
